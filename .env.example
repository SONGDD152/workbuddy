# ===== 数据库（Vercel Postgres 同构；本地用 docker compose 起 PG）=====
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/personal?schema=public"

# ===== 认证 =====
# 用于签署会话 JWT，请改成随机长字符串（生产环境务必替换）
AUTH_SECRET="change-me-to-a-long-random-string"

# ===== AI 报告（可选）=====
# 留空则 AI 报告降级为模板输出（不编造内容）
# 兼容 OpenAI 样式的接口；可填 OpenAI / DeepSeek / 通义 / 本地 LLM 等
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# ===== 图床（可选，生产走 Vercel Blob）=====
# 留空时图片上传到本地 public/uploads（仅开发用）
BLOB_READ_WRITE_TOKEN=""
