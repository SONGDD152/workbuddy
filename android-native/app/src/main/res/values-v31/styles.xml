<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ 会由系统强制插入一张启动画面（默认显示应用图标）。
      这里把图标换成透明、动画时长设 0、背景设成与窗口一致的纯色，
      让冷启动在视觉上等于「没有封面」，直接过渡到登录页。
    -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
