// 个人多频道平台 —— 数据库表设计（PostgreSQL / Vercel Postgres 同构）
// 运行：docker compose up -d && npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LoanType {
  CONSUMABLE // 消耗性借出：用完即扣库存，不需要归还
  RETURNABLE // 归还类借出：8 小时内应还，超期进预警大屏
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum ClothingType {
  TOP
  BOTTOM
  SKIRT
  OUTER
  SHOE
  HAT
  ACCESSORY
}

enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
}

enum Occasion {
  COMMUTE
  SPORT
  FORMAL
  CASUAL
}

enum StorageCategory {
  APPLIANCE
  TOOL
  DAILY
  MEDICINE
  DOCUMENT
  SEASONAL
  OTHER
}

enum ProgressStatus {
  ONGOING
  DONE
  PAUSED
}

enum PlantStatus {
  GROWING
  READY
  COMPLETED
  FAILED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  travels      Travel[]
  clothings    Clothing[]
  storageItems StorageItem[]
  warehouses   Warehouse[]
  outfitFeedbacks OutfitFeedback[]
  foodRecords  FoodRecord[]
  hobbies      Hobby[]
  gardenPlants GardenPlant[]
  books        Book[]
  movies       Movie[]
  studies      Study[]
  diaries      Diary[]
  moments        Moment[]
  momentLikes    MomentLike[]
  momentComments MomentComment[]
  stockLoans   StockLoan[]
}

/// 出库 / 借还流水。消耗性出库直接结束（无 dueAt），归还类才参与 8 小时预警。
model StockLoan {
  id             String    @id @default(cuid())
  userId         String
  itemId         String
  warehouseName  String? // 借出时所属仓库名快照，删仓库后历史仍可读
  type           LoanType
  quantity       Int       @default(1)
  borrower       String?
  note           String?
  lentAt         DateTime  @default(now())
  dueAt          DateTime? // 归还类借出：lentAt + 8h + 累计延期
  returnedAt     DateTime? // 归还时间；null = 仍在借出中
  extensionHours Int       @default(0)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item           StorageItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([userId, type, returnedAt, dueAt])
  @@index([itemId, returnedAt])
}

// ===== 朋友圈 · 动态 =====
model Moment {
  id         String          @id @default(cuid())
  userId     String
  content    String
  images     String[]        @default([]) // 图片外链，最多 9 张
  visibility Visibility      @default(PRIVATE)
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes      MomentLike[]
  comments   MomentComment[]

  @@index([userId, createdAt])
  @@index([visibility, createdAt])
}

model MomentLike {
  id        String   @id @default(cuid())
  momentId  String
  userId    String
  createdAt DateTime @default(now())
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([momentId, userId])
  @@index([momentId])
}

model MomentComment {
  id        String   @id @default(cuid())
  momentId  String
  userId    String
  content   String
  createdAt DateTime @default(now())
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([momentId, createdAt])
}

// ===== 生活 · 旅行 =====
model Travel {
  id          String        @id @default(cuid())
  userId      String
  title       String
  date        DateTime
  location    String?
  description String? // 旅行记录（公开广场会展示）
  review      String? // 回看心得·初记（私密，不进公开白名单）
  images      String[]      @default([])
  visibility  Visibility    @default(PRIVATE)
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes       TravelNote[]

  @@index([userId, date])
}

// 旅行回看评论：像评论区一样，每次回看随时补写一条带时间的心得（私密）
model TravelNote {
  id        String   @id @default(cuid())
  userId    String
  travelId  String
  content   String
  createdAt DateTime @default(now())
  travel    Travel   @relation(fields: [travelId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([travelId, createdAt])
}

// ===== 生活 · 衣橱 =====
model Clothing {
  id        String     @id @default(cuid())
  userId    String
  name      String
  type      ClothingType
  seasons   Season[]   @default([])
  occasions Occasion[] @default([])
  color     String?
  image     String?
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 穿搭推荐记忆反馈（风格偏好权重）
model OutfitFeedback {
  id        String   @id @default(cuid())
  userId    String
  comboKey  String // 例如 "TOP:1|BOTTOM:2|SHOE:3"
  adopted   Boolean
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ===== 生活 · 家庭仓储 =====
// 仓库（柜子 / 收纳箱 / 储物间）。每个仓库有名称与一张专属二维码，
// 二维码里编码的是 code（随机令牌，不是数据库 id），打印后可贴在实物上。
// 入库流程：先扫仓库码确定归属，再扫物品条码，服务端自动建记录或累加数量。
model Warehouse {
  id        String        @id @default(cuid())
  userId    String
  name      String
  code      String        @unique
  note      String?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     StorageItem[]

  @@index([userId])
}

model StorageItem {
  id           String          @id @default(cuid())
  userId       String
  name         String
  category     StorageCategory
  room         String? // 房间，如「阳台」；自动入库时写入仓库名，便于旧视图展示
  position     String? // 具体位置，如「右侧柜子第二层」
  barcode      String? // 物品条码 / 二维码
  warehouseId  String? // 所属仓库；删仓库时自动置空，不删物品
  warehouse    Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  quantity     Int             @default(1) // 同一条码重复入库时累加，不产生重复记录
  image        String?
  note         String?
  visibility   Visibility      @default(PRIVATE)
  // 物品档案二维码里的随机令牌。可空：旧数据不破坏，首次查看二维码时惰性补码。
  // 刻意不加 @unique —— 给已有表加唯一约束会触发 db push 的数据丢失保护，
  // 非交互构建直接失败；72bit 随机码 + 查询一律带 userId，碰撞风险可忽略。
  code         String?
  createdAt    DateTime        @default(now())
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  loans        StockLoan[]

  @@index([userId])
  @@index([barcode])
  @@index([code])
  @@index([warehouseId])
  @@index([userId, barcode])
}

// ===== 生活 · 餐饮 =====
model FoodRecord {
  id         String   @id @default(cuid())
  userId     String
  meal       MealType
  name       String
  note       String? // 做法备注
  calories   Int?
  image      String?
  recordedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
}

// ===== 生活 · 兴趣爱好 =====
model Hobby {
  id         String         @id @default(cuid())
  userId     String
  name       String
  visibility Visibility     @default(PRIVATE)
  createdAt  DateTime       @default(now())
  entries    HobbyEntry[]
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model HobbyEntry {
  id        String         @id @default(cuid())
  hobbyId   String
  content   String
  status    ProgressStatus @default(ONGOING)
  image     String?
  createdAt DateTime       @default(now())
  hobby     Hobby          @relation(fields: [hobbyId], references: [id], onDelete: Cascade)

  @@index([hobbyId])
}

// ===== 生活 · 园艺（兴趣子领域）=====
model Vegetable {
  id           String   @id @default(cuid())
  userId       String?
  name         String
  growDays     Int // 标准生长周期（天）
  suitableTerm String? // 适宜节气
  tag          String? // 喜温/耐寒
  isCustom     Boolean  @default(false)

  @@index([userId])
}

model GardenPlant {
  id          String      @id @default(cuid())
  userId      String
  vegetable   String // 菜名（可来自菜库）
  seedDate    DateTime // 播种日
  method      String? // 播种/移栽苗
  location    String? // 阳台/露台/菜地/盆编号
  status      PlantStatus @default(GROWING)
  note        String? // 时间线备注
  estHarvest  DateTime? // 预计成熟（可手动修正）
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ===== 图书馆 · 读书 =====
model Book {
  id         String     @id @default(cuid())
  userId     String
  title      String
  author     String?
  type       String? // 书籍类型
  visibility Visibility @default(PRIVATE)
  createdAt  DateTime   @default(now())
  notes      BookNote[]
  report     BookReport?
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BookNote {
  id        String   @id @default(cuid())
  bookId    String
  content   String
  createdAt DateTime @default(now())
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
}

model BookReport {
  id        String   @id @default(cuid())
  bookId    String   @unique
  content   String // Markdown
  score     Int?
  summary   String?
  createdAt DateTime @default(now())
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

// ===== 图书馆 · 影评 =====
model Movie {
  id         String     @id @default(cuid())
  userId     String
  title      String
  genre      String?
  visibility Visibility @default(PRIVATE)
  createdAt  DateTime   @default(now())
  notes      MovieNote[]
  report     MovieReport?
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MovieNote {
  id        String   @id @default(cuid())
  movieId   String
  content   String
  createdAt DateTime @default(now())
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId])
}

model MovieReport {
  id        String   @id @default(cuid())
  movieId   String   @unique
  content   String
  score     Int?
  summary   String?
  createdAt DateTime @default(now())
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
}

// ===== 图书馆 · 专业学习 =====
model Study {
  id         String         @id @default(cuid())
  userId     String
  topic      String
  status     ProgressStatus @default(ONGOING)
  visibility Visibility     @default(PRIVATE)
  createdAt  DateTime       @default(now())
  notes      StudyNote[]
  report     StudyReport?
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudyNote {
  id        String   @id @default(cuid())
  studyId   String
  content   String
  createdAt DateTime @default(now())
  study     Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId])
}

model StudyReport {
  id        String   @id @default(cuid())
  studyId   String   @unique
  content   String
  createdAt DateTime @default(now())
  study     Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)
}

// ===== 图书馆 · 日记 =====
model Diary {
  id        String   @id @default(cuid())
  userId    String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
